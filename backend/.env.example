# Servidor
PORT=8000

# Frontend (Vite) permitido por CORS — separar múltiples orígenes con coma
CORS_ORIGINS=http://localhost:5173

# Caché TTL en disco (segundos) para datos on-demand (precios / estados financieros)
CACHE_TTL_SECONDS=900

# Ruta del fichero SQLite (snapshot del universo)
DB_PATH=./data/app.db

# Cron del proceso planificador (app.jobs.scheduler) — formato cron de 5 campos
REFRESH_CRON=0 6 * * *
# El planificador refresca los snapshots más viejos de N horas (frescura diaria)
REFRESH_MAX_AGE_HOURS=20

# Mercados contemplados (códigos internos)
MARKETS=US,CA,UK

# Alcance del universo: equities (recomendado) | all
UNIVERSE_SCOPE=equities

# UK: solo empresas británicas en GBP (excluir cross-listings extranjeros)
UK_GBP_ONLY=true
